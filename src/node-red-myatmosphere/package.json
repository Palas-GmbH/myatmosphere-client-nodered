{
  "name": "@palasde/node-red-myatmosphere",
  "version": "1.1.4",
  "description": "A Node-Red node for subscribing to MyAtmosphere device latest measurements",
  "main": "myatmosphere.js",
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "node-red",
    "MyAtmosphere",
    "air quality",
    "environment",
    "weather",
    "air quality monitoring",
    "environment monitoring",
    "signalr",
    "measurements",
    "iot"
  ],
  "author": "Palas GmbH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palas-GmbH/myatmosphere-client-nodered.git"
  },
  "homepage": "https://github.com/Palas-GmbH/myatmosphere-client-nodered",
  "bugs": {
    "url": "https://github.com/Palas-GmbH/myatmosphere-client-nodered/issues/"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11"
  },
  "devDependencies": {
    "proxyquire": "2.1.3"
  },
  "node-red": {
    "version": ">=5.0.9",
    "nodes": {
      "myatmosphere-connection": "connection.js",
      "myatmosphere-measurements": "measurements.js"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@12.2.1",
  "examples": {
    "MyAtmosphere Single Device Measurements Example": "examples/single-device-flow.json",
    "MyAtmosphere Multiple Devices Measurements Example": "examples/multiple-devices-flow.json",
    "MyAtmosphere Alert Example": "examples/alert-flow.json",
    "MyAtmosphere Catch Errors Example": "examples/catch-errors-flow.json"
  }
